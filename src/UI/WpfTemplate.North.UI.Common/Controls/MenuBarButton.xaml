<UserControl
    x:Class="WpfTemplate.North.UI.Common.Controls.MenuBarButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfTemplate.North.UI.Common.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="60"
    d:DesignWidth="150"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/WpfTemplate.North.UI.Common;component/Styles/ResourceLibrary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Button
            Width="140"
            Margin="{Binding ButtonMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Command="{Binding MenuBarButtonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
            CommandParameter="{Binding MenuBarButtonCommandParameter, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Style="{StaticResource navMenuButton}">
            <Button.ContentTemplate>
                <DataTemplate>
                    <StackPanel Margin="7,0,0,0" Orientation="Horizontal">
                        <Viewbox Width="{Binding ViewboxWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding ViewboxHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Path
                                Data="{Binding IconData, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Fill="{Binding IconFill, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                RenderTransformOrigin="{Binding TransformOriginValue, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Stretch="Uniform">
                                <Path.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleY="{Binding ScaleTransformYValue, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </TransformGroup>
                                </Path.RenderTransform>
                            </Path>
                        </Viewbox>
                        <TextBlock
                            FontFamily="{StaticResource NeoSansStd}"
                            Foreground="{Binding MenuBarButtonTextColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource navMenuButtonText}"
                            Text="{Binding MenuBarButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                </DataTemplate>
            </Button.ContentTemplate>
        </Button>
    </StackPanel>

</UserControl>
